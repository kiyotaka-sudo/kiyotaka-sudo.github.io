pipeline {
    agent any

    environment {
        IMAGE_NAME = "mbargaernest/mbarga-portfolio"
        IMAGE_TAG  = "latest"
        CONTAINER_TEST = "portfolio-test-${BUILD_NUMBER}"
    }

    stages {

        stage('Qualité en parallèle') {
            parallel {

                stage('Lint Dockerfile') {
                    steps {
                        echo '🔍 Analyse du Dockerfile avec hadolint...'
                        sh '''
                            docker run --rm -i hadolint/hadolint < Dockerfile \
                              || echo "Warnings hadolint (non bloquant)"
                        '''
                    }
                }

                stage('Build Image') {
                    steps {
                        echo '🏗️  Build de l\'image Docker...'
                        sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    }
                }

                stage('Test acceptance') {
                    steps {
                        echo '🧪 Lancement du conteneur de test...'
                        sh """
                            docker rm -f ${CONTAINER_TEST} || true
                            docker run -d --name ${CONTAINER_TEST} -p 3099:3000 ${IMAGE_NAME}:${IMAGE_TAG}
                            sleep 5
                            curl -f http://localhost:3099 || (docker logs ${CONTAINER_TEST} && exit 1)
                            echo "✅ Test acceptance OK"
                        """
                    }
                    post {
                        always {
                            sh "docker rm -f ${CONTAINER_TEST} || true"
                        }
                    }
                }

            }
        }

        stage('Push Docker Hub') {
            when {
                branch 'main'
            }
            steps {
                echo '🚀 Push vers Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker logout
                    """
                }
            }
        }

    }

    post {
        success {
            echo '✅ Pipeline qualité terminé avec succès !'
        }
        failure {
            echo '❌ Échec du pipeline qualité.'
        }
        always {
            sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
    }
}
